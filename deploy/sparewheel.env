# Copied to /etc/sparewheel.env by setup.sh
SPAREWHEEL_AUDIO_DIR=/home/ohm/OhmFiles/audio
# Volume saved by the web page; read at every mpv launch (i.e. each reboot)
SPAREWHEEL_MPV_CONFIG=/home/ohm/OhmFiles/audio/mpv_config.json
SPAREWHEEL_RELAY_PIN=25
SPAREWHEEL_RELAY_ACTIVE_HIGH=1
# Extra mpv args, e.g. pick a specific output: --audio-device=alsa/plughw:CARD=Headphones
SPAREWHEEL_MPV_ARGS=
